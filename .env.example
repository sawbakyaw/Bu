# =============================================
# MM-BusTicket Pro - Enterprise Configuration
# =============================================
# Copy this file to .env.local for local development
# All variables are optional unless marked required

# =============================================
# Application Configuration
# =============================================
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=debug

# =============================================
# Supabase (PostgreSQL Database) [REQUIRED]
# =============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# =============================================
# Redis Cache (Distributed Locking & Caching)
# =============================================
# Redis is optional - in-memory fallback is used when not configured
# Uncomment and configure for production multi-instance deployments

# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TIMEOUT=10000
# REDIS_COMMAND_TIMEOUT=5000
# REDIS_MAX_RETRIES=3
# REDIS_KEY_PREFIX=mmbus:

# =============================================
# Seat Locking Configuration
# =============================================
# Duration in minutes before a seat lock expires
SEAT_LOCK_DURATION=10
# Maximum duration a lock can be extended to
SEAT_LOCK_MAX_DURATION=30
# How often to clean up expired locks (milliseconds)
SEAT_LOCK_CLEANUP_INTERVAL=30000
# Maximum seats one user can lock simultaneously
SEAT_LOCK_MAX_PER_SESSION=10
# Retry attempts when facing lock contention
SEAT_LOCK_RETRIES=3
# Delay between retries (milliseconds)
SEAT_LOCK_RETRY_DELAY=100

# =============================================
# Rate Limiting
# =============================================
RATE_LIMIT_ENABLED=true
# Requests per minute for each endpoint type
RATE_LIMIT_SEARCH=30
RATE_LIMIT_BOOKING=5
RATE_LIMIT_LOGIN=5
# Login window in milliseconds (15 minutes)
RATE_LIMIT_LOGIN_WINDOW=900000
RATE_LIMIT_API=100

# =============================================
# Security
# =============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trusted proxy IPs for rate limiting
TRUSTED_PROXIES=localhost,127.0.0.1
# Secret for session signing (minimum 32 characters in production)
SESSION_SECRET=change-this-to-a-secure-random-string-min-32-chars
SESSION_MAX_AGE=86400
CSRF_ENABLED=true
HELMET_ENABLED=true

# =============================================
# Logging & Monitoring
# =============================================
LOG_SERVICE=mmbus-ticketing
# Sentry for error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# Logflare for log aggregation (optional)
# LOGFLARE_API_KEY=
# LOGFLARE_SOURCE_TOKEN=

# =============================================
# External Services
# =============================================
# Payment gateway (kbzpay, wave, stripe)
# PAYMENT_GATEWAY=kbzpay
# PAYMENT_API_KEY=

# SMS provider (optional)
# SMS_PROVIDER=
# SMS_API_KEY=

# Email provider (resend, sendgrid)
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=

# =============================================
# Real-time Configuration
# =============================================
# Heartbeat interval for connection health (milliseconds)
REALTIME_HEARTBEAT=30000
# Connection timeout (milliseconds)
REALTIME_TIMEOUT=10000
# Initial reconnect delay (milliseconds)
REALTIME_RECONNECT_INITIAL=1000
# Maximum reconnect delay (milliseconds)
REALTIME_RECONNECT_MAX=60000
# Maximum reconnect attempts before suspending
REALTIME_RECONNECT_MAX_ATTEMPTS=10
# Debounce window for batching updates (milliseconds)
REALTIME_DEBOUNCE=100
# Maximum concurrent subscriptions per connection
REALTIME_MAX_SUBSCRIPTIONS=100
# Events per second limit
REALTIME_EVENTS_PER_SEC=10

# =============================================
# Analytics (Optional)
# =============================================
# NEXT_PUBLIC_GA_TRACKING_ID=your_google_analytics_id
